# ==========================================
# SlothMigrate Configuration
# ==========================================

# LLM Inference Backend (Gemma)
# Default: Google AI Studio OpenAI-compatible endpoint
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_MODEL="gemma-4-12b-it"
LLM_API_KEY="AIzaSyYourGoogleAIStudioKeyHere"

# Alternative: Local Ollama
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_MODEL="gemma2:9b"
# LLM_API_KEY="ollama"

# Alternative: DigitalOcean GPU Droplet / vLLM
# LLM_BASE_URL="http://<DROPLET_IP>:8000/v1"
# LLM_MODEL="google/gemma-4-12b-it"
# LLM_API_KEY="your-droplet-secret"

LLM_TEMPERATURE="0.1"
LLM_MAX_TOKENS="4096"

# Temporal Workflow Engine
TEMPORAL_HOST="localhost:7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TASK_QUEUE="sloth-migrate-task-queue"

# Sentry Agent Tracing & Observability
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="1.0"

# Migration Loop Guardrails
MAX_REPAIR_ATTEMPTS="5"
DEBUG="false"